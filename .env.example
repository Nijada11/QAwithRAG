# Required by the API server. The server refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me
# Required for answering questions (not for building the index or the retrieval eval).
ANTHROPIC_API_KEY=

# Optional, defaults shown.
MAX_UPLOAD_BYTES=20971520
RATE_LIMIT=30/minute
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=low
EMBED_MODEL=BAAI/bge-small-en-v1.5
CHUNK_WORDS=250
OVERLAP_WORDS=50
RETRIEVAL=hybrid
TOP_K=5
INDEX_DIR=index
# Per-question tokens, cost and latency; set empty to disable.
USAGE_LOG=logs/usage.jsonl
